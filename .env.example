# Copy to .env for local Compose. Replace the local-only database password before use.
APP_ENV=development
LOG_LEVEL=info
POSTGRES_DB=trading
POSTGRES_USER=trader
POSTGRES_PASSWORD=change-me-local-only
BACKUP_RETENTION_DAYS=14
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_ACCESS_TOKEN=
JWT_SECRET_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BROKER_CREDENTIALS_KEY=
TENANT_ID=local

# Exchange credentials are optional for public market data. Use sandbox keys only.
CRYPTO_EXCHANGE=binance
CRYPTO_API_KEY=
CRYPTO_API_SECRET=
CRYPTO_API_PASSWORD=
CRYPTO_SANDBOX=true
CRYPTO_DEFAULT_TYPE=spot
LIVE_TRADING_ENABLED=false

# MT5 integration requires a Windows host with the MT5 terminal installed.
MT5_ENABLED=false
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Automation remains disabled and paper-only by default.
ENGINE_ENABLED=false
ENGINE_SYMBOLS=BTC/USDT
ENGINE_MT5_SYMBOLS=EURUSD,XAUUSD
ENGINE_TIMEFRAME=1m
ENGINE_PAPER_MODE=true
EXECUTION_MODE=semi_auto
ENGINE_MAX_DAILY_DRAWDOWN_PCT=3.0
ENGINE_NEWS_BLACKOUT_MINUTES=15
PAPER_ACCOUNT_EQUITY=10000
NEWS_EVENTS_JSON=[]
# Trading Economics calendar API key. Required to enable fail-closed automatic news blocking.
NEWS_CALENDAR_API_KEY=
NEWS_CALENDAR_POLL_SECONDS=900
NEWS_CALENDAR_REQUIRED=false

TELEGRAM_ENABLED=false
TELEGRAM_ROLE=publisher
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_TIMEZONE=UTC

# Generate a VAPID key pair once and keep the private key secret.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:admin@example.com

# Optional provider keys; no credentials are required for the deterministic compiler.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
