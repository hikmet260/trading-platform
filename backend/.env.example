# Copy to .env for local development. Never commit populated credentials.
APP_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql+psycopg://trader:change-me-local-only@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000

# Telegram bot (optional until bot worker is configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM provider credentials (optional; keep rule execution deterministic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Crypto exchange credentials; use least-privilege, trade-only API keys.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# MetaTrader 5 credentials (MT5 terminal integration is platform-dependent)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_ENABLED=false
MT5_TERMINAL_PATH=

# Crypto market data defaults. Sandbox is enabled until explicitly disabled.
CRYPTO_EXCHANGE=binance
CRYPTO_API_KEY=
CRYPTO_API_SECRET=
CRYPTO_API_PASSWORD=
CRYPTO_SANDBOX=true
CRYPTO_DEFAULT_TYPE=spot

# Engine and paper trading remain off by default. Live execution is separately gated.
ENGINE_ENABLED=false
ENGINE_SYMBOLS=BTC/USDT
ENGINE_TIMEFRAME=1m
ENGINE_PAPER_MODE=true
ENGINE_MAX_DAILY_DRAWDOWN_PCT=3.0
ENGINE_NEWS_BLACKOUT_MINUTES=15
PAPER_ACCOUNT_EQUITY=10000
NEWS_EVENTS_JSON=[]

# Telegram bot is opt-in; approvals only open paper positions.
TELEGRAM_ENABLED=false
TELEGRAM_TIMEZONE=UTC
